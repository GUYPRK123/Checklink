# ============================================================
# .env.example — แม่แบบตัวแปรสภาพแวดล้อมของ Checklink
# ------------------------------------------------------------
# วิธีใช้: ก๊อปไฟล์นี้เป็น .env แล้วเติมค่าจริง
#     cp .env.example .env
# แอปโหลด .env ให้อัตโนมัติผ่าน load_dotenv() ใน app.py
# *** อย่า commit ไฟล์ .env จริงเข้า git เด็ดขาด ***
# ============================================================

# โหมดการรัน: development (ค่าเริ่มต้น) หรือ production
# production จะบังคับให้ต้องมี SECRET_KEY และเปิด security ที่เข้มขึ้น
FLASK_ENV=production

# กุญแจลับสำหรับเซ็น session cookie — จำเป็นตอน production
# สุ่มค่า "ครั้งเดียว" แล้วใช้ค่าเดิมตลอด (ถ้าเปลี่ยน user ทุกคนจะหลุด login)
#   python -c 'import secrets;print(secrets.token_hex(32))'
SECRET_KEY=เปลี่ยนเป็นค่าที่สุ่มมาครั้งเดียว

# origin ที่อนุญาตให้เรียก API ข้าม origin (คั่นหลายค่าด้วย ,)
# ปล่อยว่าง = ไม่เปิด CORS เลย (same-origin เท่านั้น) ซึ่งพอสำหรับการใช้งานปกติ
# เพราะ Flask เสิร์ฟหน้าเว็บเองอยู่แล้ว — ตั้งค่านี้เมื่อมีหน้าเว็บ/แอปที่อยู่คนละ origin
# ใช้ "*" ได้เฉพาะตอน dev เท่านั้น (ตอน production แอปจะปฏิเสธไม่ยอมสตาร์ต)
CORS_ORIGINS=http://198.199.122.176:5000

# ตั้ง false เมื่อเว็บยังเป็น HTTP ธรรมดา (ยังไม่มี HTTPS)
# ถ้าลืม/ปล่อยเป็น true บน HTTP ระบบ login จะพัง (ล็อกอินผ่านแต่เด้งออกตลอด)
SESSION_COOKIE_SECURE=false

# true เฉพาะตอนมี Nginx (หรือ reverse proxy อื่น) อยู่หน้า waitress บนเครื่องเดียวกันเท่านั้น
# (ดู deploy/nginx.conf, deploy/phishing-checker.service) ห้ามเปิดถ้า waitress เปิดสู่
# อินเทอร์เน็ตตรง ๆ เพราะจะทำให้ rate limit ถูกข้ามได้ด้วยการปลอม header
BEHIND_PROXY=false

# (ไม่บังคับ) ที่อยู่ฐานข้อมูล — ปล่อยว่างจะใช้ SQLite ที่ instance/app.db
# DATABASE_URL=sqlite:///instance/app.db

# (ไม่บังคับ) ที่เก็บตัวนับของ rate limit — ค่าเริ่มต้น memory:// คือนับในหน่วยความจำ
# ของ process นั้น ๆ ใช้ได้ดีกับการรันปัจจุบัน (waitress process เดียว) แต่ถ้าวันไหน
# รันหลาย process/หลายเครื่อง ตัวนับจะแยกกัน ทำให้ลิมิตหลวมเป็นเท่าตัว -> ใช้ redis แทน
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ---------- ค่าปรับแต่งเชิงธุรกิจ (ไม่บังคับ มีค่า default อยู่แล้ว) ----------
# โควตาเช็คเชิงลึกของแผนฟรี (ครั้ง/วัน)
FREE_DEEP_CHECKS_PER_DAY=5
# ราคาพรีเมียม (บาท)
PREMIUM_PRICE_THB=99
# อายุพรีเมียม (วัน)
PREMIUM_DURATION_DAYS=30
# จำนวน URL สูงสุดต่อการเช็คแบบ bulk
BULK_CHECK_MAX_URLS=20
# จำนวนลิงก์ที่ยิงตรวจ "พร้อมกัน" ในโหมด bulk (งานรอเน็ต ไม่กิน CPU)
# สูงขึ้น = เร็วขึ้นแต่เปิด connection ออกนอกพร้อมกันมากขึ้น
BULK_CHECK_WORKERS=5
# จำนวน "งาน bulk" ที่ทำพร้อมกันได้ทั้งระบบ (งานที่เกินจะรอคิว)
# ตั้งใจให้น้อย เพราะแต่ละงานเปิด thread ยิงเน็ตของตัวเองอีก BULK_CHECK_WORKERS เส้น
BULK_JOB_CONCURRENCY=2
# เก็บผลงาน bulk ไว้ให้ดึงได้นานแค่ไหนหลังเสร็จ (วินาที)
BULK_JOB_TTL=1800

# ---------- แคชผลการตรวจ ----------
# ลิงก์เดียวกันที่ถูกตรวจซ้ำภายในเวลานี้จะได้ผลเดิมทันทีโดยไม่ยิงเน็ตใหม่
# ตั้ง 0 เพื่อปิดแคช (ทุกครั้งตรวจสดหมด — ช้าลงมากถ้ามีลิงก์ไวรัล)
SCAN_CACHE_TTL=900
# จำนวนผลสูงสุดที่เก็บไว้ เกินแล้วทิ้งตัวที่ไม่ได้ใช้นานสุดก่อน
SCAN_CACHE_MAX=2000

# ---------- อุ่นเครื่องตอนสตาร์ต ----------
# ตรวจลิงก์นี้หนึ่งครั้งแบบทิ้งผลตอนเซิร์ฟเวอร์เพิ่งขึ้น เพื่ออุ่น DNS/TLS ไว้ก่อน
# ไม่งั้นผู้ใช้คนแรกหลังรีสตาร์ตทุกครั้งจะเจอการตรวจที่ช้าผิดปกติ
# ตั้งเป็นค่าว่างเพื่อปิด (เช่นตอนรันในเครื่องที่ไม่มีเน็ต)
WARMUP_URL=https://example.com
