# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เหมาะกับเครื่อง/เซิร์ฟเวอร์ของคุณ
# ห้าม commit ไฟล์ .env จริงขึ้น git (ดู .gitignore)

# development หรือ production — production จะปิด debug และบังคับ SECRET_KEY
FLASK_ENV=development

# ต้องตั้งเป็นค่าสุ่มยาวๆ ก่อนขึ้น production (เช่น: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-before-production

# ปล่อยว่าง = ใช้ SQLite ไฟล์ backend/instance/app.db (ค่าเริ่มต้น เพียงพอสำหรับโปรเจกต์นี้)
# DATABASE_URL=

# origin ของ frontend จริงตอน production (คั่นด้วย , ถ้ามีหลาย origin) — ห้ามปล่อย * ตอนขึ้นจริง
CORS_ORIGINS=*

# true เฉพาะตอนรันผ่าน HTTPS จริงเท่านั้น (ไม่งั้น cookie จะถูกเบราว์เซอร์บล็อกตอน dev ที่เป็น http)
# ตอนขึ้น production ต้องตั้ง Nginx + certbot ให้มี HTTPS ก่อน (ดู deploy/nginx.conf)
# ค่อยเปิดตัวนี้เป็น true ไม่งั้น login/session จะใช้งานไม่ได้
SESSION_COOKIE_SECURE=false

# true เฉพาะตอนมี Nginx (หรือ reverse proxy อื่น) อยู่หน้า waitress บนเครื่องเดียวกันเท่านั้น
# (ดู deploy/nginx.conf, deploy/phishing-checker.service) ห้ามเปิดถ้า waitress เปิดสู่
# อินเทอร์เน็ตตรง ๆ เพราะจะทำให้ rate limit ถูกข้ามได้ด้วยการปลอม header
BEHIND_PROXY=false

FREE_DEEP_CHECKS_PER_DAY=5
PREMIUM_PRICE_THB=99
PREMIUM_DURATION_DAYS=30
BULK_CHECK_MAX_URLS=20
