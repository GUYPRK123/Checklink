# ============================================================================
# deploy/phishing-checker.service — systemd unit สำหรับรัน Checklink ค้างไว้
# วิธีติดตั้ง: sudo cp deploy/phishing-checker.service /etc/systemd/system/ &&
#             sudo systemctl daemon-reload && sudo systemctl enable --now phishing-checker
# ============================================================================
[Unit]
Description=Checklink — เว็บตรวจลิงก์/QR หลอกลวง (Flask + waitress)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=checkurl
Group=checkurl
WorkingDirectory=/home/checkurl/Checklink/backend
ExecStart=/home/checkurl/Checklink/backend/.venv/bin/python serve.py
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/checkurl/Checklink/backend/instance
ReadWritePaths=/home/checkurl/Checklink/backend/analyzer

[Install]
WantedBy=multi-user.target
